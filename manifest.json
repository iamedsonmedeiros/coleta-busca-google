{
  "manifest_version": 3,
  "name": "Coleta da Busca Google",
  "version": "0.1.0",
  "description": "Percorre as páginas de resultados do Google e exporta cada item em CSV ou XLSX, marcado como orgânico, anúncio, IA, mapa ou outro.",
  "minimum_chrome_version": "116",
  "incognito": "spanning",
  "permissions": ["sidePanel", "tabs", "scripting", "downloads", "storage", "webRequest"],
  "host_permissions": ["https://www.google.com/*", "https://www.google.com.br/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Coleta da Busca Google",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
